//#include <dt-bindings/zmk/mouse.h>

#include <behaviors/rgbled_widget.dtsi>
#include <behaviors/naginata.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE     0
#define MOUSE    1
#define LOWER    2
#define RAISE    3
#define ADJUST   4
#define SCROLL   2

// スクロール量の設定

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <3 2>;
            then-layer = <4>;
        };
    };
};

/ {
    behaviors {
        // スクロール用のbehaviorの設定

        scroll_down_up: behavior_sensor_rotate_mouse_wheel_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>; // スクロールのタップ時間
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT LANG2>, <&mo 0>, <&mo 1>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt RCTL LANG1>, <&mo 0>, <&mo 1>;
        };

        // Customed Hold-Tap for SandS

        SandS: SandS {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <500>;
            quick-tap-ms = <500>;
            bindings = <&kp>, <&kp>;

            display-name = "SandS";
        };
    };
};

&sl { release-after-ms = <250>; }; // time needed for double click (for mkp_exit_AML)
/ {
    macros {
        // When in AML, move to default layer when key (except mouse button) pressed
        // When LCLK pressed, exit AML (after 250ms cause by sticky layer
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
            bindings = <
&kp ESC    &kp N1      &kp N2  &kp N3    &kp N4        &kp N5                         &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                         &kp NUMBER_6  &kp N7  &kp N8     &kp N9   &kp N0     &kp TILDE
&kp TAB    &kp Q       &kp W   &kp E     &kp R         &kp T                          &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                       &kp Y         &kp U   &kp I      &kp O    &kp P      &kp MINUS
&kp CAPS   &kp A       &kp S   &kp D     &kp F         &kp G      &kp APOS            &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &kp SEMI           &kp H         &kp J   &kp K      &kp L    &kp ENTER  &mo 1
&kp LSHFT  &kp Z       &kp X   &kp C     &kp V         &kp B      &kp LEFT_BRACKET    &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp RIGHT_BRACKET  &kp N         &kp M   &kp COMMA  &kp DOT  &kp FSLH   &lt 4 BACKSLASH
&kp LCTRL  &kp C_MUTE          &kp LWIN  &kp LEFT_ALT  &kp SPACE  &mo 3                                                                       &mo 3              &kp BSPC                                             &kp DEL
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&none   &none   &none           &none           &none            &none             &trans  &trans  &trans  &trans            &none     &none  &none           &none           &none            &trans
&trans  &none   &none           &kp UP_ARROW    &none            &none             &trans  &trans  &trans  &trans            &none     &none  &msc SCRL_LEFT  &msc SCRL_UP    &msc SCRL_RIGHT  &trans
&trans  &none   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none   &none     &trans  &trans  &trans  &trans    &none   &none     &none  &mkp LCLK       &mkp MCLK       &mkp RCLK        &trans
&trans  &none   &none           &none           &none            &none   &none     &trans  &trans  &trans  &trans    &none   &none     &none  &mkp MB4        &msc SCRL_DOWN  &mkp MB5         &trans
&trans  &trans                  &trans          &trans           &trans  &trans                                      &trans  &kp BSPC                                                          &trans
            >;
        };

        raise_layer {
            bindings = <
&trans      &kp F1           &kp F2       &kp F3    &kp F4             &kp F5                 &trans  &trans  &trans  &trans            &kp F6     &kp F7         &kp F8        &kp F9                &kp F10                &kp PLUS
&kp ESCAPE  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR         &kp PERCENT            &trans  &trans  &trans  &trans            &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS
&trans      &kp N1           &kp N2       &kp N3    &kp N4             &kp N5       &trans    &trans  &trans  &trans  &trans    &trans  &kp N6     &kp N7         &kp N8        &kp N9                &kp N0                 &kp EQUAL
&trans      &kp TILDE        &kp GRAVE    &kp APOS  &kp DOUBLE_QUOTES  &kp INT_YEN  &trans    &trans  &trans  &trans  &trans    &trans  &kp SEMI   &kp COLON      &kp COMMA     &kp DOT               &kp FSLH               &kp BSLH
&trans      &trans                        &trans    &trans             &trans       &trans                                      &trans  &trans                                                                               &trans
            >;

            label = "raise";
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        lower_layer {
            display-name = "Lower";
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
            bindings = <
&trans      &kp F1           &kp F2        &kp F3        &kp F4             &kp F5                  &trans  &trans  &trans  &trans            &kp F6         &kp F7         &kp F8        &kp F9                &kp F10                &kp PLUS
&kp ESCAPE  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR         &kp PERCENT             &trans  &trans  &trans  &trans            &kp CARET      &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS
&trans      &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4       &kp NUMBER_5  &trans    &trans  &trans  &trans  &trans    &trans  &kp NUMBER_6   &kp NUMBER_7   &kp NUMBER_8  &kp NUMBER_9          &kp NUMBER_0           &kp EQUAL
&trans      &kp TILDE        &kp GRAVE     &kp SQT       &kp DOUBLE_QUOTES  &kp INT_YEN   &trans    &trans  &trans  &trans  &trans    &trans  &kp SEMICOLON  &kp COLON      &kp COMMA     &kp PERIOD            &kp SLASH              &kp BACKSLASH
&trans      &trans                         &trans        &trans             &trans        &trans                                      &trans  &trans                                                                                   &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
            bindings = <
&trans      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4            &trans  &trans  &trans  &trans                    &bt BT_CLR_ALL  &none         &none         &none    &none    &none
&kp ESCAPE  &kp F1        &kp F2        &kp F3        &kp F4        &kp F5                  &trans  &trans  &trans  &trans                    &kp F6          &kp F7        &kp F8        &kp F9   &kp F10  &none
&trans      &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &none           &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &kp F11  &kp F12  &none
&trans      &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &studio_unlock  &bt BT_CLR_ALL  &bt BT_CLR    &out OUT_TOG  &none    &none    &none
&trans      &kp C_MUTE                  &trans        &trans        &trans        &trans                                      &trans          &kp DEL                                                       &kp DEL
            >;
        };
    };
};
